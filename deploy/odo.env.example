APP_ENV=production
APP_PUBLIC_URL=https://access.example.edu
# Publish the corresponding source for this exact deployment before production startup.
APP_SOURCE_URL=
APP_BUILD_REVISION=
# Optional plain-text legal notice; the AGPL license link remains visible.
APP_LICENSE_NOTICE=
APP_DATA_DIR=/var/lib/odo
APP_CONFIG_DIR=/etc/odo
APP_KEY_HASH_SECRET=change-me
APP_ADMIN_API_KEY=change-me
APP_PROXY_REQUIRE_LOGIN=true
APP_TRUST_PROXY_HEADERS=true
