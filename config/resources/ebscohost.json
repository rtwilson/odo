  "request_header_rules": [
    {
      "name": "Authorization",
      "action": "remove",
      "phase": "request"
    },
    {
      "name": "OPAQUE-TOKEN",
      "action": "remove",
      "phase": "request"
    },
    {
      "name": "userIdentifier",
      "action": "remove",
      "phase": "request"
    },
    {
      "name": "X-EIS-FEATURE-FLAG",
      "action": "remove",
      "phase": "request"
    },
    {
      "name": "X-EIS-STSTOKEN",
      "action": "remove",
      "phase": "request"
    },
    {
      "name": "Prefer",
      "action": "remove",
      "phase": "request"
    }
  ],
  "user_header_rules": [
    {
      "name": "X-EBSCO-PROXY-Username",
      "phase": "request",
      "value_template": "{username}",
      "encoding": "base64",
      "enabled": false,
      "notes": "Models EZproxy AddUserHeader -base64 X-EBSCO-PROXY-Username. Disabled by default because it releases user identity to the vendor; enable only after privacy and license review."
    }
  ],
  "anonymous_url_rules": [
    {
      "pattern": "https://ppws.ebsco-content.com/*",
      "behavior": "allow_public_proxy",
      "methods": [
