{
  "id": "jstor",
  "title": "JSTOR",
  "status": "active",
  "description": "JSTOR resource profile with explicit proxy behavior",
  "entry_urls": [
    "https://www.jstor.org/"
  ],
  "http_methods": [
    "GET",
    "HEAD",
    "POST",
    "PUT",
    "PATCH",
    "OPTIONS",
    "DELETE"
  ],
  "cookie_policy": {
    "enabled": true,
    "jar_scope": "resource",
    "allowed_cookie_domains": [
      "jstor.org"
    ]
  },
  "request_header_rules": [
    {
      "name": "X-Requested-With",
      "action": "remove",
      "phase": "request"
    }
  ],
  "domains": [
    {
      "host": "www.jstor.org",
      "behavior": "proxy",
      "include_subdomains": false,
      "role": "content"
    },
    {
      "host": "jstor.org",
      "behavior": "proxy",
      "include_subdomains": true,
      "role": "content"
    },
    {
      "host": "dfr.jstor.org",
      "behavior": "proxy",
      "include_subdomains": false,
      "role": "content"
    },
    {
      "host": "labs.jstor.org",
      "behavior": "proxy",
      "include_subdomains": false,
      "role": "content"
    },
    {
      "host": "links.jstor.org",
      "behavior": "proxy",
      "include_subdomains": false,
      "role": "redirect"
    },
    {
      "host": "mobile.jstor.org",
      "behavior": "proxy",
      "include_subdomains": false,
      "role": "content"
    },
    {
      "host": "about.jstor.org",
      "behavior": "proxy",
      "include_subdomains": false,
      "role": "content"
    },
    {
      "host": "plants.jstor.org",
      "behavior": "proxy",
      "include_subdomains": false,
      "role": "content"
    },
    {
      "host": "uk.jstor.org",
      "behavior": "proxy",
      "include_subdomains": false,
      "role": "content"
    },
    {
      "host": "jstore.org",
      "behavior": "proxy",
      "include_subdomains": true,
      "role": "content",
      "notes": "Alias domain from legacy proxy stanza"
    },
    {
      "host": "analytics.example.com",
      "behavior": "block",
      "include_subdomains": false,
      "role": "unknown",
      "notes": "Example explicit tracking block"
    }
  ],
  "compatibility": {
    "referer_recovery": true,
    "js_shim": true,
    "app_data_recovery": true
  },
  "sample_urls": [
    "https://www.jstor.org/stable/example"
  ]
}
